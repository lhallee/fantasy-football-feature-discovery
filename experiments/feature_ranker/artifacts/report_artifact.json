  "sources": [
    {
      "id": "points-ranking",
      "label": "Phase 2 offense FeatureRanker results",
      "path": "experiments/feature_ranker/artifacts/points_feature_ranking.csv",
      "query": {
        "engine": "DuckDB",
        "language": "sql",
        "sql": "SELECT * FROM read_csv_auto('experiments/feature_ranker/artifacts/points_feature_ranking.csv') ORDER BY consensus_rank LIMIT 20",
        "description": "Five-method FeatureRanker consensus for the leakage-controlled Phase 2 offense-points discovery matrix.",
        "filters": [
          "Target seasons 2013 through 2021",
          "Positions QB, RB, WR, and TE",
          "Selected stable core-plus-trajectory feature contract",
          "Constant features removed before ranking"
        ],
        "metric_definitions": [
          "Consensus score is probe-skill-weighted reciprocal-rank voting across Random Forest, XGBoost, mutual information, ANOVA F-test, and L1 rankings.",
          "Methods top 10 is the count of the five component rankers that place the feature in their own top ten."
        ],
        "tables_used": [
          "Phase 2 August-origin offense discovery matrix"
        ]
      }
    },
    {
      "id": "injury-ranking",
      "label": "Phase 3 injury FeatureRanker results",
      "path": "experiments/feature_ranker/artifacts/injury_feature_ranking.csv",
      "query": {
        "engine": "DuckDB",
        "language": "sql",
        "sql": "SELECT * FROM read_csv_auto('experiments/feature_ranker/artifacts/injury_feature_ranking.csv') ORDER BY consensus_rank LIMIT 20",
        "description": "Five-method FeatureRanker consensus for the leakage-controlled Phase 3 physical injury-report discovery matrix.",
        "filters": [
          "Target seasons 2013 through 2021",
          "Positions QB, RB, WR, TE, and K",
          "Target is any regular-season physical injury-report designation",
          "Constant features removed before ranking"
        ],
        "metric_definitions": [
          "Consensus score is probe-skill-weighted reciprocal-rank voting across Random Forest, XGBoost, mutual information, ANOVA F-test, and L1 rankings.",
          "The injury outcome is report presence, not games missed or biological fragility."
        ],
        "tables_used": [
          "Phase 3 August-origin injury-report discovery matrix"
        ]
      }
    },
    {
      "id": "robustness-summary",
      "label": "FeatureRanker aggregation sensitivity",
      "path": "experiments/feature_ranker/artifacts/report_robustness.csv",
      "query": {
        "engine": "DuckDB",
        "language": "sql",
        "sql": "SELECT * FROM read_csv_auto('experiments/feature_ranker/artifacts/report_robustness.csv') ORDER BY target",
        "description": "Aggregation sensitivity and discovery-matrix dimensions from the executed notebook.",
        "metric_definitions": [
          "Top-20 overlap is the number of exact features shared with the primary automatic reciprocal-rank consensus."
        ],
        "tables_used": [
          "experiments/feature_ranker/artifacts/report_robustness.csv"
        ]
      }
    },
    {
      "id": "probe-summary",
      "label": "FeatureRanker component-method probes",
      "path": "experiments/feature_ranker/artifacts/report_probes.csv",
      "query": {
        "engine": "DuckDB",
        "language": "sql",
        "sql": "SELECT * FROM read_csv_auto('experiments/feature_ranker/artifacts/report_probes.csv') ORDER BY target, method",
        "description": "Cross-validated linear-probe diagnostics used by FeatureRanker automatic vote weighting.",
        "metric_definitions": [
          "Probe score is mean three-fold cross-validated R-squared for points or balanced accuracy for injury across top-k feature cuts."
        ],
        "tables_used": [
          "experiments/feature_ranker/artifacts/report_probes.csv"
        ]
      }
    },
    {
      "id": "notebook",
      "label": "Executed FeatureRanker notebook",
      "path": "experiments/feature_ranker/featureranker_points_injury.ipynb",
      "query": {
        "engine": "Jupyter",
        "language": "python",
        "description": "Executable reconstruction, profiling, ranking, sensitivity, and visualization workflow.",
        "tables_used": [
          "Frozen local fantasy-football project inputs"
        ]
      }
    }
  ]
